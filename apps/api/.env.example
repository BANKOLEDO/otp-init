# Core
DATABASE_URL=sqlite+aiosqlite:///./otp_init.db
SECRET_KEY=change-me-to-a-random-string
API_KEY=your-api-key-here

# Verification 
# OTP code length (default: 6)
OTP_LENGTH=6
# Time-to-live in seconds (default: 300 = 5 minutes)
OTP_TTL=300
# Max retry attempts before lockout (default: 5)
MAX_ATTEMPTS=5

# Channels
# WhatsApp Business API token from developers.facebook.com
WHATSAPP_TOKEN=
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Signal CLI sender account (with country code). Recipient numbers are supplied per OTP request.
SIGNAL_PHONE=
# Executable name or full path, for example C:\\Tools\\signal-cli\\bin\\signal-cli.bat
SIGNAL_CLI_PATH=signal-cli
# Seconds before a Signal CLI send is treated as failed
SIGNAL_CLI_TIMEOUT=30

# CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Development
DEBUG=false
